# Supabase (server-side only; never prefix the service key with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL for metadata/canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Admin sign-in (server-side only). Leave unset to disable /login and /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 32+ random characters; signs the session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
