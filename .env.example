# ---- Supabase (server-side only; never prefix any of these with NEXT_PUBLIC_) -------------------------------------
SUPABASE_URL=
# Public "anon" key. Every request made with it is limited by Row Level Security (drafts and private data stay hidden).
SUPABASE_ANON_KEY=
# Service-role key: bypasses ALL security rules. Used only by scripts/create-owner.mjs and by the older test-ride and
# dealer features. Keep it out of git, out of logs, and out of any browser.
SUPABASE_SERVICE_ROLE_KEY=
# ---- Site -----------------------------------------------------------------------------------------------------
# Public site URL for metadata/canonical links and password-recovery emails (must also be listed as a Redirect URL
# in Supabase: Authentication -> URL Configuration).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-off schema setup only (scripts/apply-migrations.mjs). Never used by the website.
DATABASE_URL=
